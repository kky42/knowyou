# knowyou configuration. Copy to ~/.knowyou/config.yaml and change only what you need.

schedule:
  updateEverySeconds: 1800

scan:
  # Estimated tokens in normalized, unprocessed transcript text (UTF-8 bytes / 4).
  # Below minNewTokens stays pending; maxNewTokens bounds each raw session slice.
  minNewTokens: 20000
  maxNewTokens: 80000
  windowDays: 7
  minUserTurns: 2
  redactSecrets: true

  # Omit this field to scan every supported harness.
  harnesses:
    - pi
    - codex
    - claude
    - grok

agent:
  # The background agent that preprocesses, observes, and consolidates memory.
  # Omit model/thinking to inherit Pi's configured defaults.
  # model: provider/model
  # thinking: medium

observe:
  # Up to four compacted slices are sent in one model call, serially.
  batchSize: 4
  maxObservationChars: 500
  # Cold-start guard; remaining slices are retried on the next scheduled run.
  maxSlicesPerRun: 10

consolidate:
  # When the pool reaches this count, all pending observations are folded in one call.
  triggerObservations: 30
  maxMemoryChars: 20000
